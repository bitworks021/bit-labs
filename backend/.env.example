# Rate limits per client IP within each window (defaults shown).
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_API_PER_IP=300
RATE_LIMIT_COMPILE_PER_IP=20
RATE_LIMIT_UPLOAD_PER_IP=10
RATE_LIMIT_LIBRARY_CHANGES_PER_IP=30
# Set to true only behind a trusted TLS-terminating reverse proxy.
REQUIRE_HTTPS=false
# Set to true only when exactly one trusted reverse proxy overwrites X-Forwarded-For/-Proto.
TRUST_PROXY=false
